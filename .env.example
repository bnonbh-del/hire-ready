# Copy this file to .env.local and fill in the values.
# Supabase: Dashboard -> Project Settings -> API Keys.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# "Publishable key" (starts with sb_publishable_). Safe in the browser:
# Row Level Security decides what it can read.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# "Secret key" (starts with sb_secret_). SERVER ONLY. Never share it, never
# commit it, never prefix it with NEXT_PUBLIC_. It bypasses Row Level Security.
SUPABASE_SECRET_KEY=sb_secret_xxx

# The public address of the site (used for share links and link previews).
# Locally: http://localhost:3000. On Vercel: https://your-domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000
